MONGODB_USERNAME=<username>
MONGODB_PASSWORD=<password>
MONGODB_CLUSTER=<cluster-url>
MONGODB_APP_NAME=doa-net
MONGODB_DB_NAME=doa_net_db

# Stripe (obter em https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# URLs para onde o Stripe redireciona após o pagamento (produção: substitua pelo domínio real)
STRIPE_SUCCESS_URL=http://localhost:8000/doacoes/sucesso
STRIPE_CANCEL_URL=http://localhost:8000/doacoes/cancelado

obs) rodar backend: poetry run uvicorn main:app --reload --host 127.0.0.1 --port 8000
obs) webhook local: stripe listen --forward-to localhost:8000/doacoes/webhook